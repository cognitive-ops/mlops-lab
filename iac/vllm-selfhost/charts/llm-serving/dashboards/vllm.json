{
  "title": "vLLM Serving",
  "uid": "vllm-serving",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["llm", "vllm"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests running / waiting",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "running", "expr": "sum(vllm:num_requests_running)" },
        { "refId": "B", "legendFormat": "waiting", "expr": "sum(vllm:num_requests_waiting)" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Replicas (available / desired)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "available", "expr": "kube_deployment_status_replicas_available{deployment=\"vllm\"}" },
        { "refId": "B", "legendFormat": "desired", "expr": "kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"keda-hpa-vllm\"}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Time to first token (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))" },
        { "refId": "C", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Inter-token latency (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[5m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[5m])))" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "End-to-end latency (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token throughput (tokens/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "prompt", "expr": "sum(rate(vllm:prompt_tokens_total[5m]))" },
        { "refId": "B", "legendFormat": "generation", "expr": "sum(rate(vllm:generation_tokens_total[5m]))" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "KV cache usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}}", "expr": "vllm:kv_cache_usage_perc" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prefix-cache hit rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "hit rate", "expr": "sum(rate(vllm:prefix_cache_hits_total[5m])) / sum(rate(vllm:prefix_cache_queries_total[5m]))" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GPU utilization",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{Hostname}}", "expr": "DCGM_FI_DEV_GPU_UTIL" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Preemptions / s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "preemptions", "expr": "sum(rate(vllm:num_preemptions_total[5m]))" }
      ]
    }
  ]
}
