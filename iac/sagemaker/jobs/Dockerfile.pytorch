# Build custom image for SageMaker training job
# Use PyTorch image as base
FROM 763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-training:2.0.0-cpu-py310-ubuntu20.04-sagemaker

WORKDIR /workspace

# Install Python dependencies
RUN pip install numpy boto3 wandb tensorboard

# Or GPU (CUDA 11.8)
RUN pip install torchvision==0.15.2 torchaudio==2.0.2 --index-url https://download.pytorch.org/whl/cu118

WORKDIR /workspace