# Port SGLang's OpenAI-compatible API is exposed on
SGLANG_PORT=30000

# HuggingFace model repo to serve
MODEL_REPO=meta-llama/Llama-3.1-8B-Instruct

# Max context length (KV cache budget)
MAX_MODEL_LEN=8192

# Tool-calling parser matching the model family — required for LangChain/LangGraph
# .bind_tools() to work. Options: llama3, qwen25, mistral, hermes, deepseekv3, etc.
# See: https://docs.sglang.ai/backend/function_calling.html
TOOL_CALL_PARSER=llama3

# Required for gated repos (e.g. meta-llama/*) — https://huggingface.co/settings/tokens
HF_TOKEN=

# Host dir mounted into the container for HF weights cache (avoids re-download)
HF_CACHE_DIR=./.cache/huggingface
