# Base URL of the SGLang OpenAI-compatible server (local docker-compose default,
# or the ALB/EIP endpoint from iac/sglang-selfhost + "/v1")
SGLANG_BASE_URL=http://localhost:30000/v1

# SGLang doesn't check this, but the OpenAI SDK requires a non-empty value
SGLANG_API_KEY=EMPTY

# Must match the model-path the SGLang server was launched with
MODEL_REPO=meta-llama/Llama-3.1-8B-Instruct
